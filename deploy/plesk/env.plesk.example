APP_ENV=production
APP_SECRET_KEY=change-me
ADMIN_API_TOKEN=change-me

# SQLite keeps RAM low. Plesk already has Postgres if you later outgrow this.
DATABASE_URL=sqlite:////opt/fplpredictor/data/fpl.db

FPL_USER_AGENT=FPLPredictor/0.1 (plesk)
TIMEZONE=Europe/London
DAILY_REFRESH_HOUR=6
DAILY_REFRESH_MINUTE=0
LOG_LEVEL=INFO

CURRENT_SEASON=2026-27
HISTORICAL_SEASON=2025-26
PRIOR_SEASON=2024-25
