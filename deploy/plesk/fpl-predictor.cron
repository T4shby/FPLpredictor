# Europe/London 06:00 — one-shot refresh, then exit.
# Install: sudo cp deploy/plesk/fpl-predictor.cron /etc/cron.d/fpl-predictor
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
CRON_TZ=Europe/London
0 6 * * * fplpredictor cd /opt/fplpredictor && /opt/fplpredictor/.venv/bin/python scripts/run_daily_refresh.py >> /opt/fplpredictor/logs/refresh.log 2>&1
