APP_ENV=development
APP_SECRET_KEY=change-me
ADMIN_API_TOKEN=change-me

DATABASE_URL=postgresql+psycopg2://fpl:fpl@localhost:5432/fpl
# Local default if Postgres is unavailable:
# DATABASE_URL=sqlite:///./fpl_local.db

FPL_USER_AGENT=FPLPredictor/0.1 (local-dev)
FPL_BASE_URL=https://fantasy.premierleague.com/api
HISTORICAL_REPO_BASE=https://raw.githubusercontent.com/vaastav/Fantasy-Premier-League/master/data

DATA_CACHE_DIR=./data/cache
SNAPSHOT_DIR=./data/snapshots
REPORT_DIR=./reports/generated
LOG_LEVEL=INFO

TIMEZONE=Europe/London
DAILY_REFRESH_HOUR=9
DAILY_REFRESH_MINUTE=0

MODEL_VERSION=0.1.0
FEATURE_VERSION=0.1.0
CURRENT_SEASON=2026-27
HISTORICAL_SEASON=2025-26
PRIOR_SEASON=2024-25

DIFFERENTIAL_OWNERSHIP_MAX=10.0
ULTRA_DIFFERENTIAL_OWNERSHIP_MAX=5.0
HIT_MIN_NET_XPTS=1.5
